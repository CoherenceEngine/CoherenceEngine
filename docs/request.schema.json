{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed evaluation request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "records"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "features"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "features": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
