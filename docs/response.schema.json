{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed evaluation response v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "provenance",
    "engine_version",
    "baseline_version",
    "decisions"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "enum": [
        "integration_mock",
        "licensed_engine"
      ]
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "baseline_version": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "route",
          "reason_code"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "enum": [
              "invoke_baseline",
              "approved_bypass",
              "fallback_baseline",
              "hold_for_review"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
